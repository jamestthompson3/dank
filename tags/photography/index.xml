-20251228-084509"&gt;&lt;picture&#10; title="A pine sapling"&gt;&#10; &lt;source&#10; srcset="https://teukka.tech/images/photo-20251228-084509.webp"&gt;&#10; &lt;img&#10; class="u-photo"&#10; src="https://teukka.tech/images/photo-20251228-084509.webp"&#10; alt="A pine sapling" &gt;&#10; &lt;/picture&gt;&#10; &lt;/a&gt;&#10; &#10; &lt;figcaption&gt;Pine&lt;/figcaption&gt;&#10; &lt;/figure&gt;&#10; &#10;&lt;/div&gt;&#10;&#10;&lt;div class="picture"&gt;&#10; &#10; &lt;figure&gt;&#10; &#10; &lt;a href="photo-20251228-084543"&gt;&lt;picture&#10; title="View of a church on a hill from the water"&gt;&#10; &lt;source&#10; srcset="https://teukka.tech/images/photo-20251228-084543.webp"&gt;&#10; &lt;img&#10; class="u-photo"&#10; src="https://teukka.tech/images/photo-20251228-084543.webp"&#10; alt="View of a church on a hill from the water" &gt;&#10; &lt;/picture&gt;&#10; &lt;/a&gt;&#10; &#10; &lt;figcaption&gt;From the water&lt;/figcaption&gt;&#10; &lt;/figure&gt;&#10; &#10;&lt;/div&gt;&#10;&#10;&lt;div class="picture"&gt;&#10; &#10; &lt;figure&gt;&#10; &#10; &lt;a href="photo-20251228-084402"&gt;&lt;picture&#10; title="A sunset over an island, rugged landscape"&gt;&#10; &lt;source&#10; srcset="https://teukka.tech/images/photo-20251228-084402.webp"&gt;&#10; &lt;img&#10; class="u-photo"&#10; src="https://teukka.tech/images/photo-20251228-084402.webp"&#10; alt="A sunset over an island, rugged landscape" &gt;&#10; &lt;/picture&gt;&#10; &lt;/a&gt;&#10; &#10; &lt;figcaption&gt;Sunset from the top of the island&lt;/figcaption&gt;&#10; &lt;/figure&gt;&#10; &#10;&lt;/div&gt;&#10;&#10;&lt;div class="picture"&gt;&#10; &#10; &lt;figure&gt;&#10; &#10; &lt;a href="photo-20251228-084609"&gt;&lt;picture&#10; title="View of a small village jutting out into the water"&gt;&#10; &lt;source&#10; srcset="https://teukka.tech/images/photo-20251228-084609.webp"&gt;&#10; &lt;img&#10; class="u-photo"&#10; src="https://teukka.tech/images/photo-20251228-084609.webp"&#10; alt="View of a small village jutt